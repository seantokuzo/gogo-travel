# GoGo Travel — environment template. Real values live in per-workspace
# `.env` files, which are gitignored (Law #1). NEVER commit real values.
#
#   apps/server/.env   <- server secrets (loaded by `node --env-file-if-exists`)
#   apps/mobile/.env   <- EXPO_PUBLIC_* only (inlined into the bundle = public)
#
# Canonical schema for the server side: `apps/server/src/env.ts`.

# ===========================================================================
# apps/server/.env
# ===========================================================================

NODE_ENV=development
PORT=3000

# Postgres connection string (Neon in prod, testcontainers in tests).
# Optional at boot — health runs DB-less; first DB access throws without it.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- Auth (T-5.2). ALL-OR-NOTHING across these 8: a PARTIAL set throws at
# --- boot; a wholly empty set boots health-only with /auth unmounted.

# Our access-token signing key. ES256 PKCS#8 PEM as a \n-escaped single line:
#   openssl ecparam -genkey -name prime256v1 -noout \
#     | openssl pkcs8 -topk8 -nocrypt | awk 'BEGIN{ORS="\\n"}1'
AUTH_ES256_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGHA...\n-----END PRIVATE KEY-----\n"
# `kid` stamped on access tokens — any stable string; rotate by adding a key.
AUTH_ES256_KID=dev-key-1

# Apple `aud` — must equal app.json `ios.bundleIdentifier`.
APPLE_CLIENT_ID=com.example.gogotravel
# Google `aud` allowlist — comma-separated OAuth client ids (iOS + web).
GOOGLE_CLIENT_IDS=<ios>.apps.googleusercontent.com,<web>.apps.googleusercontent.com

# Sign in with Apple code exchange (Apple Developer portal → Keys → .p8).
APPLE_TEAM_ID=ABCDE12345
APPLE_KEY_ID=ABCDE12345
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----\n"
# AES-256-GCM key encrypting the stored Apple refresh token — exactly 32
# bytes, base64:  openssl rand -base64 32
APPLE_CREDENTIALS_KEY=

# --- Test/dev rig shortcut (T-S3.1): don't hand-build the 8 auth vars —
# --- generate a gitignored apps/server/.env.test with throwaway keys:
# ---   node scripts/gen-test-env.mjs        (then: pnpm --filter @gogo/server dev:testenv)
# --- Throwaway keys are GENERATED, never committed (ADR-006; Law #1).
# --- Automated boot-shape coverage: apps/server/src/boot-shape.test.ts.

# --- Optional. Absent => that feature degrades visibly, never errors.
# Mapbox Directions API (driving/walking/cycling travel legs).
MAPBOX_ACCESS_TOKEN=
# Transit legs; defaults to the keyless public instance.
# TRANSITOUS_BASE_URL=https://api.transitous.org
# Places spine ingest datasets (dated release snapshots — deploy-time config).
# PLACES_OVERTURE_PARQUET_URL=
# PLACES_FSQ_OS_PARQUET_URL=

# ===========================================================================
# apps/mobile/.env  — EXPO_PUBLIC_* are inlined into the bundle: NO SECRETS
# ===========================================================================

# Leave UNSET for device/simulator dev — the API base is derived from the
# Metro host so a phone on the same LAN reaches this Mac automatically.
# Setting it to localhost breaks the device build.
# EXPO_PUBLIC_API_URL=https://api.example.com

EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
